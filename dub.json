{
	"description": "Xlibre/Xorg X server ported on D programming language",
	"license": "MIT",
	"authors": [
		"Roman Vlasov aka Doctor(porting on D)",
		"stuff previously worked on Xlibre/Xorg projects"
	],
	"copyright": "Copyright © 2026, Roman Vlasov",
	"name": "xenia",
	"dependencies": {
	},
	"targetType": "executable",
	"dflags": [
		"-version=_XSERVER64",
		"-version=__SIZEOF_LONG__",
		"-version=LONG64",
		"-version=CONFIG_UDEV",
		"-version=HAVE_FNMATCH_H",
		"-i",
    "-P-I/usr/include/dbus-1.0",
    "-P-I/usr/include/pixman-1",
    "-P-I/usr/lib/dbus-1.0/include",
    "-P-Isource/Xext/dri2",
    "-P-I/usr/include/libdrm",
    "-P-Isource",
    "-P-Isource/hw/xfree86/x86emu",
    "-P-Isource/externs",
	"-P-D__int128=long long",
    "-P-D__attribute__(x)=",
	"-P-D__alignof__(x)=8",
	"-P=-D__kernel_size_t=size_t",
	"-deps=/tmp/Xenia.deps"
    ],
	"excludedSourceFiles": [
		"source/hw/kdrive/*",
		"source/hw/xnest/*",
		"source/hw/xquartz/*",
		"source/hw/xwin/*",
		"source/hw/vfb/*"
		
	],
	"lflags-posix-dmd": [
		"-L--export-dynamic",
        "-ldbus-1",
        "-ldrm",
        "-lgbm",
        "-lpixman-1",
		"-lcrypto",
		"-lXfont2",
		"-lXau",
		"-lxshmfence",
		"-lpciaccess",
		"-lseat",
		"-lxcvt",
		"-lepoxy",
		"-lxcb",
		"-lxcb-ewmh",
		"-laudit",
		"-ludev",
		"-lhal",
		"-lGL",
		"-lXdmcp"
	],
	"preBuildCommands": [
	]
}
